# --- Required: AnnexKit collector credential -----------------------------
# Get one with `make seed` from the project root, then paste here.
ANNEXKIT_API_KEY=

# --- Required: Anthropic API key -----------------------------------------
# Get one at https://console.anthropic.com/ then paste here.
ANTHROPIC_API_KEY=

# --- Optional: collector URL (default: http://localhost:8033) ------------
# ANNEXKIT_COLLECTOR_URL=http://localhost:8033
