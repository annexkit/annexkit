# --- Required: AnnexKit collector credential -----------------------------
# Get one with `make seed` from the project root, then paste here.
ANNEXKIT_API_KEY=

# --- Optional: collector URL (default: http://localhost:8033) ------------
# ANNEXKIT_COLLECTOR_URL=http://localhost:8033

# --- Optional: real OpenAI calls -----------------------------------------
# When OPENAI_API_KEY is set, the demo invokes gpt-4o-mini for each turn.
# When unset, a deterministic rule-based stub is used so the demo runs
# without external dependencies.
# OPENAI_API_KEY=sk-...
