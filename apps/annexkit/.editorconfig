# https://editorconfig.org/
# Tells most editors what indentation, line endings, and final newline
# convention this repo uses, so contributors don't fight each other's
# tabs vs spaces.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,jsonc,css,html,yml,yaml,md}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{py,toml}]
indent_size = 4
