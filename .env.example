# ------------------------------------------------------------------
# AnnexKit — local development .env TEMPLATE
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# ------------------------------------------------------------------

# --- Runtime -------------------------------------------------------
# 'dev' enables SQL echo + verbose logging. Use 'prod' in production.
ENV=dev

# --- Database ------------------------------------------------------
# Inside the docker network the host is `db`, the port is 5432, and the
# credentials match docker-compose.yml. Outside docker, swap `db` for
# `localhost` and use port 5438 (host-side mapping).
DATABASE_URL=postgresql+asyncpg://annexkit:dev_password@db:5432/annexkit

# --- Security ------------------------------------------------------
# HMAC key used to hash tenant API keys in the DB.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be set to something non-default before staging/prod.
SECRET_KEY=dev-only-insecure-change-me-in-production

# --- CORS ----------------------------------------------------------
# Origins allowed to call the API from a browser. Add the trust center
# domain here once the Next.js frontend ships (M3).
CORS_ORIGINS=["http://localhost:3000"]

# --- Document storage ----------------------------------------------
# Where generated Annex IV PDFs are persisted on disk. In docker the
# default is a named volume mounted inside the container.
DOCUMENT_STORAGE_PATH=/data/documents

# --- LLM advisor (Mistral La Plateforme, EU-hosted) ----------------
# Used by the risk engine for ambiguity advisory only. The classifier
# itself is rules-driven and runs without this key. Leave blank in dev
# unless you're working on Day 4+.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed

# --- Frontend (Next.js trust center) -------------------------------
# Where the Next.js process resolves the collector. Inside compose
# this is the service name + container port; for ``make frontend-dev``
# (running on the host) it should be the host-mapped port.
#
#   docker compose:    BACKEND_URL=http://backend:8000
#   make frontend-dev: BACKEND_URL=http://localhost:8033
#
# The compose file overrides this for the frontend container; setting
# it in .env only affects host-side ``npm run dev``.
BACKEND_URL=http://backend:8000

# --- Public site URL (used by Next.js for OpenGraph + canonical) ---
# Set to the actual public host once you go live. Defaults to
# annexkit.dev so social-share previews on dev still resolve.
NEXT_PUBLIC_SITE_URL=https://annexkit.dev
